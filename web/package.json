{
  "name": "mieszko-monitor-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --webpack --hostname 127.0.0.1 --port 3180",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1 --port 3180",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/frontend.test.ts",
    "prepare:map": "node scripts/prepare-map-assets.mjs",
    "predev": "npm run prepare:map",
    "prebuild": "npm run prepare:map",
    "pretest": "npm run prepare:map",
    "build:pages": "node scripts/build-pages.mjs"
  },
  "dependencies": {
    "maplibre-gl": "6.6.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
